# Copy to .env.local and fill in. Never commit .env.local.
# Claude (B5 note reading). Leave blank to use saved readings only.
ANTHROPIC_API_KEY=
# Supabase (database, staff login, live sync). Leave blank to use the local file store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: the clinic's time zone (IANA name). Leave blank for America/Moncton (New Brunswick).
# CLINIC_TIME_ZONE=America/Moncton
